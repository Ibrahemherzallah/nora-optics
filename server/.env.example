# MongoDB — MUST be a replica set for transactions (Atlas works out of the box,
# or run a single-node replica set locally: mongod --replSet rs0 then rs.initiate())
MONGODB_URI=mongodb://127.0.0.1:27017/nora_optics?replicaSet=rs0

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# Seed admin (used once by `npm run seed`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App
CLIENT_URL=http://localhost:5173
PORT=4000
